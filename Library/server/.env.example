# MongoDB Atlas — set URI to use cloud database (recommended)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/library_app?retryWrites=true&w=majority

# 1 = FILE mode (no Mongo). 0 = use MongoDB when MONGODB_URI is set
USE_FILE_STORE=0

JWT_SECRET=change-this-to-a-long-random-string
PORT=3001
DEFAULT_TEACHER_ID=T001
DEFAULT_TEACHER_PASSWORD=teacher123
DEFAULT_TEACHER_NAME=Library Teacher

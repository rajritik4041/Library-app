# App reads books/stats from MongoDB via API (not Excel).
# Excel → catalog.json is only offline fallback when server is down.

# Copy to Library/.env for local dev (optional)
# Physical Android/iOS device on same Wi‑Fi — use your PC IP, not localhost:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001

# Production / APK (EAS sets this in eas.json — must be MongoDB server):
EXPO_PUBLIC_API_URL=https://library-app-2-e5ly.onrender.com

{
  "name": "library",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "prestart": "node ./scripts/import-books.js",
    "preweb": "node ./scripts/import-books.js",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start-web": "expo start --web",
    "desktop": "concurrently -k -n web,electron -c blue,magenta \"npm run start-web\" \"wait-on http://127.0.0.1:8081 && electron electron/main.js\"",
    "export-web": "cross-env EXPO_PUBLIC_API_URL=https://library-app-2-e5ly.onrender.com expo export --platform web",
    "desktop:prod": "npm run export-web && cross-env NODE_ENV=production electron electron/main.js",
    "preexport-web": "node ./scripts/import-books.js",
    "desktop:pack": "npm run desktop:pack:win",
    "desktop:pack:win": "npm run export-web && node ./scripts/prepare-desktop-pack.js && node ./scripts/run-desktop-pack.js",
    "desktop:pack:mac": "npm run export-web && node ./scripts/prepare-desktop-pack.js && node ./scripts/run-desktop-pack-mac.js",
    "desktop:pack:linux": "npm run export-web && node ./scripts/prepare-desktop-pack.js && node ./scripts/run-desktop-pack-linux.js",
    "import-books": "node ./scripts/import-books.js",
    "watch-books": "node ./scripts/watch-excel.js",
    "server": "npm run start --prefix server",
    "sync-backend": "node ../scripts/sync-backend.js",
    "dev:all": "node ./scripts/import-books.js && npm run server",
    "lint": "expo lint"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.24",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.34",
    "expo-device": "~55.0.17",
    "expo-font": "~55.0.7",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.10",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.18",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.2",
    "wait-on": "^8.0.5",
    "xlsx": "^0.18.5"
  },
  "private": true
}
